{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Worker serving the Next.js storefront (built by OpenNext).
  "name": "maktabah-storefront",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Static assets (/_next/static, fonts, images) are served from Cloudflare's CDN.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      // Next.js incremental cache (ISR) for revalidated pages.
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "maktabah-next-cache"
    }
  ],
  // Runtime configuration. Wrangler copies these into process.env on each cold
  // start, so changing one takes effect on the next deploy without a rebuild.
  // NEXT_PUBLIC_* names would NOT work here: Next.js compiles those into the
  // bundle at build time (see .env.production). These unprefixed names are read
  // by src/lib/config.ts and override the compiled-in fallbacks.
  "vars": {
    // Public origin of the Medusa backend. The admin lives at <this>/app and is
    // served by the backend alone, never proxied through this Worker.
    "MEDUSA_BACKEND_URL": "https://api.maktabahruhayn.com",
    // This Worker's own public origin.
    "SITE_URL": "https://maktabahruhayn.com",
    // Store API publishable key: admin > Settings > Publishable API keys.
    // Required - without it the Store API rejects every request.
    "MEDUSA_PUBLISHABLE_KEY": ""
  },
  // Attach the custom domain once the zone is on this Cloudflare account.
  // Until then the Worker is reachable at <name>.<subdomain>.workers.dev.
  // "routes": [
  //   { "pattern": "maktabahruhayn.com", "custom_domain": true },
  //   { "pattern": "www.maktabahruhayn.com", "custom_domain": true }
  // ],
  "observability": { "enabled": true }
}
