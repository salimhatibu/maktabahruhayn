{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cloudflare Worker serving the Next.js storefront (built by OpenNext).
	"name": "maktabah-storefront",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Static assets (/_next/static, fonts, images) are served from Cloudflare's CDN.
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// The shop's database. Every Worker binds it directly; there is no API
	// server in between. Run `pnpm db:create` once and paste the id here.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "maktabah",
			"database_id": "72b1d9a6-280b-4051-824f-94adf1ce7679",
			"migrations_dir": "../../packages/db/migrations"
		}
	],
	"r2_buckets": [
		{
			// Next.js incremental cache (ISR) for revalidated pages.
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "maktabah-next-cache"
		}
	],
	// Runtime configuration. Wrangler copies these into process.env on each cold
	// start, so changing one takes effect on the next deploy without a rebuild.
	// NEXT_PUBLIC_* names would NOT work here: Next.js compiles those into the
	// bundle at build time (see .env.production). These unprefixed names are read
	// by src/lib/config.ts and override the compiled-in fallbacks.
	"vars": {
		// This Worker's own public origin.
		"SITE_URL": "https://maktabahruhayn.com",
		// Payments and shipping. Only the non-secret half belongs here; the rest
		// are Worker secrets:
		//   wrangler secret put STRIPE_API_KEY
		//   wrangler secret put STRIPE_WEBHOOK_SECRET
		//   wrangler secret put DARAJA_CONSUMER_KEY
		//   wrangler secret put DARAJA_CONSUMER_SECRET
		//   wrangler secret put DARAJA_PASSKEY
		//   wrangler secret put DARAJA_CALLBACK_TOKEN   (16+ random chars: openssl rand -hex 24)
		//   wrangler secret put SHIPPO_API_KEY
		// A provider with no credentials is simply not offered at checkout.
		// The callback token is appended to DARAJA_CALLBACK_URL automatically and
		// checked on every callback; without it M-Pesa is not offered, because
		// its confirmations would be refused. Give the admin Worker the same one.
		"DARAJA_SHORTCODE": "",
		"DARAJA_ENVIRONMENT": "sandbox",
		// Safaricom posts here; the token guards it, since Daraja cannot sign.
		"DARAJA_CALLBACK_URL": "https://maktabahruhayn.com/api/payment/mpesa/callback",
		"SHIPPO_FROM_NAME": "Maktabah Ruhayn",
		"SHIPPO_FROM_STREET1": "",
		"SHIPPO_FROM_CITY": "Nairobi",
		"SHIPPO_FROM_STATE": "Nairobi",
		"SHIPPO_FROM_ZIP": "00100",
		"SHIPPO_FROM_COUNTRY": "KE",
		"SHIPPO_FROM_PHONE": "",
		"SHIPPO_FROM_EMAIL": ""
	},
	// maktabahruhayn.com is attached to the router Worker (apps/router), which
	// serves this Worker through a service binding; it is not attached here.
	// Until the zone is on this Cloudflare account the shop is reachable at
	// <name>.<subdomain>.workers.dev.
	"observability": {
		"enabled": true
	}
}