{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Worker serving the Next.js storefront (built by OpenNext).
  "name": "maktabah-storefront",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Static assets (/_next/static, fonts, images) are served from Cloudflare's CDN.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      // Next.js incremental cache (ISR) for revalidated pages.
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "maktabah-next-cache"
    }
  ],
  // Replace with your real domains before deploying.
  "vars": {
    "NEXT_PUBLIC_MEDUSA_BACKEND_URL": "https://api.maktabahruhayn.com",
    "NEXT_PUBLIC_SITE_URL": "https://maktabahruhayn.com"
  },
  "observability": { "enabled": true }
}
