# Build-time configuration for the deployed storefront. Committed on purpose:
# every value here is public, and a fresh checkout (Cloudflare Workers Builds,
# CI) needs no extra setup to produce a correct bundle.
#
# Next.js compiles each NEXT_PUBLIC_* value into the bundle, so these cannot be
# changed after the build. `pnpm cf:build` loads this file as real environment
# variables so it also beats a developer's .env.local; anything already set in
# the build environment wins over this file.
#
# For the two URLs below, the deployed Worker can still override them at
# runtime through the unprefixed LEGACY_BACKEND_URL and SITE_URL variables in
# wrangler.jsonc - these are only the compiled-in fallbacks.


# This storefront's own public origin (canonical URLs, Open Graph, robots).
NEXT_PUBLIC_SITE_URL=https://maktabahruhayn.com

# Read in the browser, so it has to be set at build time. Optional: it only
# enables the card payment option. Pair with STRIPE_API_KEY on the backend.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Shown in the Help Center when the admin has no contact email set.
NEXT_PUBLIC_SUPPORT_EMAIL=
