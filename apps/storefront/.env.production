# Build-time configuration for the deployed storefront.
#
# Next.js inlines every NEXT_PUBLIC_* value into the bundle while building, so
# these cannot be changed by a Worker variable afterwards: whatever is set here
# (or in the build environment, which wins over this file) is what the deployed
# site uses forever. Only public values belong in this file; it is committed.
#
# A real environment variable overrides any line here, so Cloudflare Workers
# Builds can set these in the dashboard instead.

# The Medusa backend's public origin. The admin dashboard lives at <this>/app
# and is deliberately not reachable through the storefront domain.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.maktabahruhayn.com

# The storefront's own public origin (canonical URLs, Open Graph, sitemaps).
NEXT_PUBLIC_SITE_URL=https://maktabahruhayn.com

# Publishable API key of the production store: admin > Settings > Publishable
# API keys. Required - the Store API rejects requests without it. A deploy
# build refuses to run while this is empty.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Optional. Enables the card payment option; pair with STRIPE_API_KEY on the backend.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. Shown on the Help Center when the admin has no contact email set.
NEXT_PUBLIC_SUPPORT_EMAIL=
