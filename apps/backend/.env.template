# This backend's public origin. The admin dashboard is served at <it>/app, and
# it is the base of every upload URL when media is stored on local disk rather
# than R2. Leave it unset in development (the admin then uses whatever host you
# open it on, so http://<lan-ip>:9000/app keeps working); set it in production.
# MEDUSA_BACKEND_URL=https://api.example.com

# Serve the API without the admin dashboard.
ADMIN_DISABLED=false

# Extra CORS origins. MEDUSA_BACKEND_URL and STOREFRONT_URL are always allowed,
# so these only need origins beyond those two.
STORE_CORS=http://localhost:3000,http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# Replace both in production (openssl rand -base64 32). With these defaults
# anyone can forge an admin session; the backend warns at boot.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# Prefer system Postgres :5432 when available; user-space fallback uses :5433
DATABASE_URL=postgres://medusa:medusa@127.0.0.1:5433/medusa-maktabah
DB_NAME=medusa-maktabah
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
TYPESENSE_COLLECTION=books
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_CALLBACK_URL=http://localhost:9000/api/payment/mpesa/callback
DARAJA_ENVIRONMENT=sandbox
SHIPPO_API_KEY=
SHIPPO_FROM_NAME=Maktabah Ruhayn
SHIPPO_FROM_STREET1=Nairobi CBD
SHIPPO_FROM_CITY=Nairobi
SHIPPO_FROM_STATE=Nairobi
SHIPPO_FROM_ZIP=00100
SHIPPO_FROM_COUNTRY=KE

# Free standard (postal) shipping thresholds in major units; 0 disables
FREE_SHIPPING_THRESHOLD_USD=60
FREE_SHIPPING_THRESHOLD_KES=7500

# Shared secret for POST /webhooks/shippo?token=...
SHIPPO_WEBHOOK_SECRET=

# Exchange-rate cache lifetime (ms). Rates come from open.er-api.com.
FX_CACHE_TTL_MS=21600000

# Optional comma-separated allowlist of Safaricom callback IPs
DARAJA_ALLOWED_IPS=

# Outgoing email (any SMTP provider). Without SMTP_HOST, emails are logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Maktabah Ruhayn <orders@example.com>"
# Public storefront URL used in email links
STOREFRONT_URL=http://localhost:3000

# Media storage. With these set, uploads go to Cloudflare R2 and are served from
# R2_PUBLIC_URL. Without them the local provider writes to apps/backend/static
# and serves from MEDUSA_BACKEND_URL/static, which most hosts wipe on redeploy.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
