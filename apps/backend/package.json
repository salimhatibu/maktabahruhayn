{
  "name": "@maktabah/backend",
  "version": "0.0.1",
  "description": "Maktabah Ruhayn Medusa backend",
  "author": "Maktabah Ruhayn",
  "license": "MIT",
  "keywords": [
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa",
    "bookstore"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "seed:typesense": "medusa exec ./src/scripts/seed-typesense-collection.ts",
    "seed:regions": "medusa exec ./src/scripts/seed-maktabah-regions.ts",
    "seed:fulfillment": "medusa exec ./src/scripts/seed-fulfillment.ts",
    "seed:catalog": "medusa exec ./src/scripts/seed-catalog.ts",
    "cleanup:legacy": "medusa exec ./src/scripts/cleanup-legacy-products.ts",
    "seed:promotions": "medusa exec ./src/scripts/seed-promotions.ts",
    "seed:store-products": "medusa exec ./src/scripts/seed-store-products.ts",
    "assign:super-admin": "medusa exec ./src/scripts/assign-super-admin.ts",
    "backfill:product-numbers": "medusa exec ./src/scripts/backfill-product-numbers.ts",
    "hero:images": "medusa exec ./src/scripts/hero-images-from-category.ts",
    "db:generate": "medusa db:generate book",
    "db:migrate": "medusa db:migrate",
    "db:rollback": "medusa db:rollback book",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@maktabah/shared": "workspace:*",
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/caching": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/dashboard": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/icons": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@tanstack/react-query": "5.64.2",
    "nodemailer": "10.0.10",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "typesense": "^2.1.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.2",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}