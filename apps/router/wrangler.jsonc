{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// The front door for both hostnames. See worker.js and the "Hosts" section
	// of the README.
	"name": "maktabah",
	"main": "worker.js",
	"compatibility_date": "2026-09-01",
	"services": [
		{
			"binding": "STOREFRONT",
			"service": "maktabah-storefront"
		},
		{
			"binding": "ADMIN",
			"service": "maktabah-admin"
		}
	],
	"vars": {
		// Host-based surfaces: the shop on PUBLIC_HOST, the admin on ADMIN_HOST.
		"PUBLIC_HOST": "maktabahruhayn.com",
		"ADMIN_HOST": "admin.maktabahruhayn.com",
		// Where /admin on the shop sends people. Until admin.maktabahruhayn.com
		// is attached this is the admin Worker's own address; afterwards set it
		// to "https://admin.maktabahruhayn.com".
		"ADMIN_ORIGIN": "https://admin.maktabahruhayn.com"
	},
	"routes": [
		{ "pattern": "maktabahruhayn.com", "custom_domain": true },
		{ "pattern": "admin.maktabahruhayn.com", "custom_domain": true }
	],
	"observability": { "enabled": true }
}
